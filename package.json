{
  "name": "tencerecim",
  "version": "1.2.194",
  "description": "Tencerecim Mağaza Yönetim Sistemi",
  "main": "electron/main.js",
  "author": "Tencerecim",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "electron": "electron .",
    "vite": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "guvenlik:kur": "node scripts/guvenlik-kur.js",
    "guvenlik:tara": "node scripts/sizinti-tara.js --tumu",
    "guvenlik:denetle": "node scripts/sizinti-tara.js --tumu && npm audit --omit=dev --audit-level=high",
    "postinstall": "node scripts/guvenlik-kur.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2",
    "better-sqlite3": "9.6.0",
    "electron-updater": "6.8.9",
    "jsbarcode": "3.12.3",
    "recharts": "3.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.0",
    "concurrently": "9.2.3",
    "electron": "22.3.27",
    "electron-builder": "24.13.1",
    "postcss": "8.5.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "2.6.0",
    "react-router-dom": "6.30.4",
    "tailwindcss": "3.4.19",
    "vite": "5.4.21",
    "vite-plugin-electron": "0.28.8",
    "vitest": "4.1.9",
    "wait-on": "8.0.5"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "com.tencerecim.magaza",
    "productName": "Tencerecim Mağaza",
    "artifactName": "tencerecim-setup-${version}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/electron/dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tencerecim Magaza"
    },
    "publish": {
      "provider": "github",
      "owner": "May-neym-iz-name",
      "repo": "tencerecim-updates"
    }
  }
}
