            "command": "cmd.exe /d /v:off /s /c '\"\"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\indeks-hatirlat.cmd\"\"'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /d /v:off /s /c '\"\"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\indeks-hatirlat.cmd\"\"'",
            "timeout": 10
          }
        ]
      }
    ]
